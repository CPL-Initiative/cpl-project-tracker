*.bak
__pycache__/
*.pyc
.DS_Store

# First Light reflections digest — anonymous user musings rendered for the
# PRIVATE vault samueltlee/CPLBrain (reflections/build_reflections_digest.py).
# NEVER commit reflection text to this PUBLIC repo; the digest is gitignored and
# is meant to land in the private vault clone (or via a weekly workflow in that
# repo). cpl-knowledge-base is a PUBLIC subset of the vault — never the digest
# target. (The aggregate-only reflections/summary.json — counts + painting
# tallies, no text — IS safe to commit and is intentionally NOT ignored.)
reflections_out/

# Claude Code background-agent worktrees (transient, harness-managed)
.claude/worktrees/

# Node deps for the jsdom render tests — dev-only, never committed.
node_modules/
package-lock.json

# Gitleaks artifacts
gitleaks-report.json
gitleaks.exe

# Re-mint step 1a: bulky regenerated machine-layer PREVIEWS (reproducible via
# kb/_remint_apply.py; landed to the real coci_*.json paths only on approval).
kb/remint_out/coci_minted_courses.json
kb/remint_out/coci_minted_memberships.json
kb/remint_out/coci_minted_singletons.json
kb/remint_out/coci_articulations.json
kb/remint_out/coci_unified_courses.json

# Row audit: full per-row breakdown is local-only for debugging; latest.json
# (slim summary + full cluster cards) and <date>.md are the gitted artifacts.
kb/row_audit/*.full.json

# Exhibit audit: same shape as row_audit — full per-row breakdown is the
# local-only debugging artifact; latest.json + <date>.md are gitted.
kb/exhibit_audit/*.full.json

# Classifier dry-run preview — local-only debugging artifact written by
# classify_exhibits.py --dry-run.
kb/_classify_dryrun_sample.json

# ── Student/staff PII — NEVER commit to this PUBLIC repo ──
# The raw MAP CustomReport pull contains student names/DOB/IDs and staff
# contact info (View_StudentAggregatedValues, View_CollegeContacts,
# View_CollegeUsersRoles). It is fetched fresh on every run and read by
# excel_to_dashboard.py at runtime; only the *aggregated* public artifacts
# may be committed. Keep this raw file out of git (and out of GitHub Pages).
CustomReport_*.json
kb/similar_family_out/

# First Light curation scratch (assembled into tools/first_light_selection.json, then discarded)
tools/_fl_sel/

# CPL nudges — runtime PII + generated outputs stay out of git (repo is public)
nudges/emails.local.json
nudges/nudges.json
