    {
     "line": "We are looking for a new president for College of Alameda",
     "position": "college_ceo",
     "window": [
      "College of Alameda is committed to serving the educational needs of our diverse community by providing comprehensive and flexible programs and resources that empower students to achieve their goals.",
      "Future Students",
      "New/Returning Students",
      "We are looking for a new president for College of Alameda",
      "Visit the search page for more info",
      "Fields of Study",
      "Apply and Enroll at College of Alameda and join our dynamic, diverse community in pursuing a brighter future. With tons of academic programs providing Degrees and Certificates in a wide variety of disciplines, talented instructors in Career and Technical Education, and the tools you'll need to successfully transfer to a four-year institution, we are here to help you get to where you need to be."
     ],
     "emails": []
    }
