    {
     "line": "We meet on the last Thursday of the month. For time & location, contact VSG President Gabriel Flesher at coa.vsg@gmail.com coa.vsg@gmail.com.",
     "position": "college_ceo",
     "window": [
      "Veterans Student Group",
      "The mission of the CoA Veterans Student Group is to facilitate transitions into civilian life post-military, enhance educational opportunities for Veterans, provide a mechanism for camaraderie among Veteran Soldiers, Sailors, Airmen, Marines, Officers, Enlisted, other First Responders and Uniformed Services as well as to foster “deckplate” level leadership among the student body at the College of Alameda and within the local community.",
      "The VSG is open to College of Alameda students who are Veterans of the U.S. Armed Forces. Auxiliary membership is available to students who are Dependents of Veterans or members of the uniformed services.",
      "We meet on the last Thursday of the month. For time & location, contact VSG President Gabriel Flesher at coa.vsg@gmail.com coa.vsg@gmail.com.",
      "College of Alameda",
      "555 Ralph Appezzato Memorial Pkwy, Alameda, CA 94501",
      "(510) 522-7221"
     ],
     "emails": [
      "coa.vsg@gmail.com"
     ]
    }
