{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding row, contract v0",
  "description": "One CSV row: what a second reading caught in a partner's file, and who fixes it. Empty cells are absent.",
  "type": "object",
  "required": ["college", "drop", "file", "finding", "detail", "fix_owner"],
  "additionalProperties": false,
  "properties": {
    "college": {"type": "string", "minLength": 1},
    "drop": {"type": "string", "pattern": "^(inbound|outbound)/[a-z0-9/-]+/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "file": {"type": "string", "minLength": 1},
    "row": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "field": {"type": "string"},
    "finding": {"enum": ["wrong_link", "ctid_reused", "code_masked", "code_suffixed", "kind_misfiled", "framework_overloaded", "wrong_college_file", "no_match", "disagrees_with_coci", "other"]},
    "detail": {"type": "string", "minLength": 1},
    "fix_owner": {"enum": ["college", "credential-engine", "wested", "cobi"]}
  }
}
